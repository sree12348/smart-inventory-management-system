import React, { useEffect, useMemo, useState } from 'react';
import { createRoot } from 'react-dom/client';
import './style.css';

const API = '/api';

type Product = {
  id: number;
  sku: string;
  name: string;
  category_id: number;
  category: string;
  price: number;
  stock: number;
};
type Category = { id: number; name: string };
type Order = { id: number; customer: string; status: string; total: number };
type ProductForm = { sku: string; name: string; categoryId: string; price: string };

const emptyForm: ProductForm = { sku: '', name: '', categoryId: '', price: '' };

async function request<T>(path: string, options?: RequestInit): Promise<T> {
  const response = await fetch(`${API}${path}`, {
    ...options,
    headers: { 'Content-Type': 'application/json', ...(options?.headers || {}) },
  });
  if (!response.ok) {
    const body = await response.text();
    let message = body;
    try {
      const parsed = JSON.parse(body);
      message = parsed.detail || parsed.message || body;
    } catch { /* response was plain text */ }
    throw new Error(message || `Request failed (${response.status})`);
  }
  if (response.status === 204) return undefined as T;
  return response.json() as Promise<T>;
}

function App() {
  const [products, setProducts] = useState<Product[]>([]);
  const [categories, setCategories] = useState<Category[]>([]);
  const [orders, setOrders] = useState<Order[]>([]);
  const [stats, setStats] = useState<Record<string, number>>({});
  const [search, setSearch] = useState('');
  const [categoryFilter, setCategoryFilter] = useState('all');
  const [form, setForm] = useState<ProductForm>(emptyForm);
  const [editingId, setEditingId] = useState<number | null>(null);
  const [showForm, setShowForm] = useState(false);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const [message, setMessage] = useState('');

  const load = async () => {
    try {
      const [p, c, o, d] = await Promise.all([
        request<Product[]>('/products'),
        request<Category[]>('/categories'),
        request<Order[]>('/orders'),
        request<Record<string, number>>('/dashboard'),
      ]);
      setProducts(p);
      setCategories(c);
      setOrders(o);
      setStats(d);
      setError('');
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    }
  };

  useEffect(() => { void load(); }, []);

  const visibleProducts = useMemo(() => {
    const term = search.trim().toLowerCase();
    return products.filter((p) => {
      const matchesText = !term || [p.sku, p.name, p.category].some((v) => v.toLowerCase().includes(term));
      const matchesCategory = categoryFilter === 'all' || String(p.category_id) === categoryFilter;
      return matchesText && matchesCategory;
    });
  }, [products, search, categoryFilter]);

  const openAdd = () => {
    setEditingId(null);
    setForm({ ...emptyForm, categoryId: categories[0] ? String(categories[0].id) : '' });
    setShowForm(true);
    setError('');
    setMessage('');
  };

  const openEdit = (p: Product) => {
    setEditingId(p.id);
    setForm({ sku: p.sku, name: p.name, categoryId: String(p.category_id), price: String(p.price) });
    setShowForm(true);
    setError('');
    setMessage('');
  };

  const saveProduct = async (event: React.FormEvent) => {
    event.preventDefault();
    setBusy(true);
    setError('');
    setMessage('');
    try {
      const payload = {
        sku: form.sku.trim(),
        name: form.name.trim(),
        categoryId: Number(form.categoryId),
        price: Number(form.price),
      };
      if (!payload.sku || !payload.name || !payload.categoryId || !Number.isFinite(payload.price) || payload.price < 0) {
        throw new Error('Please complete all fields and enter a valid non-negative price.');
      }
      if (editingId === null) {
        await request('/products', { method: 'POST', body: JSON.stringify(payload) });
        setMessage('Product added successfully. Set its stock in the inventory section in the next phase.');
      } else {
        await request(`/products/${editingId}`, { method: 'PUT', body: JSON.stringify(payload) });
        setMessage('Product updated successfully.');
      }
      setShowForm(false);
      setForm(emptyForm);
      await load();
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setBusy(false);
    }
  };

  const deleteProduct = async (p: Product) => {
    if (!window.confirm(`Delete "${p.name}"? Products already used in orders cannot be deleted.`)) return;
    setBusy(true);
    setError('');
    setMessage('');
    try {
      await request(`/products/${p.id}`, { method: 'DELETE' });
      setMessage(`${p.name} deleted.`);
      await load();
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setBusy(false);
    }
  };

  const placeOrder = async (p: Product) => {
    setBusy(true);
    setError('');
    setMessage('');
    try {
      await request('/orders', {
        method: 'POST',
        body: JSON.stringify({ customerId: 1, productId: p.id, warehouseId: 1, quantity: 1 }),
      });
      setMessage(`Order created for ${p.name}.`);
      await load();
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setBusy(false);
    }
  };

  return (
    <main>
      <header className="topbar">
        <div>
          <span className="eyebrow">OPERATIONS / INVENTORY CONTROL</span>
          <h1>Smart Inventory</h1>
          <p>Manage products, monitor stock and keep orders moving.</p>
        </div>
        <button className="primary add-top" onClick={openAdd}>＋ Add product</button>
      </header>

      <section className="stats">
        <article><small>Total products</small><strong>{stats.products ?? '—'}</strong><span>Catalog items</span></article>
        <article><small>Total orders</small><strong>{stats.orders ?? '—'}</strong><span>Orders created</span></article>
        <article><small>Units in stock</small><strong>{stats.unitsInStock ?? '—'}</strong><span>Across warehouses</span></article>
        <article><small>Order revenue</small><strong>${Number(stats.revenue || 0).toFixed(2)}</strong><span>Excluding cancelled orders</span></article>
      </section>

      {error && <div className="notice error">{error}</div>}
      {message && <div className="notice success">{message}</div>}

      <section className="panel">
        <div className="section-heading">
          <div><span className="section-kicker">CATALOG</span><h2>Product management</h2><p>Search, filter, add and maintain your product catalog.</p></div>
          <button className="primary" onClick={openAdd}>＋ New product</button>
        </div>
        <div className="filters">
          <input aria-label="Search products" placeholder="Search by name, SKU or category…" value={search} onChange={(e) => setSearch(e.target.value)} />
          <select aria-label="Filter by category" value={categoryFilter} onChange={(e) => setCategoryFilter(e.target.value)}>
            <option value="all">All categories</option>
            {categories.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
          <span className="result-count">{visibleProducts.length} products</span>
        </div>
        <div className="scroll">
          <table>
            <thead><tr><th>SKU</th><th>Product</th><th>Category</th><th>Unit price</th><th>Stock</th><th>Order</th><th>Manage</th></tr></thead>
            <tbody>
              {visibleProducts.map((p) => (
                <tr key={p.id}>
                  <td><span className="sku">{p.sku}</span></td>
                  <td className="product-name">{p.name}</td>
                  <td>{p.category}</td>
                  <td>${Number(p.price).toFixed(2)}</td>
                  <td><span className={p.stock > 5 ? 'stock' : 'stock low'}>{p.stock}</span></td>
                  <td><button className="small primary" disabled={busy || p.stock < 1} onClick={() => void placeOrder(p)}>Order 1</button></td>
                  <td><div className="actions"><button className="small secondary" disabled={busy} onClick={() => openEdit(p)}>Edit</button><button className="small danger" disabled={busy} onClick={() => void deleteProduct(p)}>Delete</button></div></td>
                </tr>
              ))}
              {visibleProducts.length === 0 && <tr><td colSpan={7} className="empty">No products match your search.</td></tr>}
            </tbody>
          </table>
        </div>
      </section>

      <section className="panel">
        <div className="section-heading"><div><span className="section-kicker">FULFILLMENT</span><h2>Recent orders</h2><p>Latest customer orders and their current status.</p></div></div>
        <div className="scroll">
          <table>
            <thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead>
            <tbody>
              {orders.map((o) => <tr key={o.id}><td>#{o.id}</td><td>{o.customer}</td><td><span className="status">{o.status}</span></td><td>${Number(o.total).toFixed(2)}</td></tr>)}
              {orders.length === 0 && <tr><td colSpan={4} className="empty">No orders yet.</td></tr>}
            </tbody>
          </table>
        </div>
      </section>

      {showForm && (
        <div className="modal-backdrop" role="presentation" onMouseDown={(e) => { if (e.target === e.currentTarget) setShowForm(false); }}>
          <section className="modal" role="dialog" aria-modal="true" aria-labelledby="product-form-title">
            <div className="modal-heading"><div><span className="section-kicker">PRODUCT CATALOG</span><h2 id="product-form-title">{editingId === null ? 'Add a product' : 'Edit product'}</h2></div><button className="icon-button" aria-label="Close" onClick={() => setShowForm(false)}>×</button></div>
            <form onSubmit={saveProduct}>
              <label>SKU<input required maxLength={60} value={form.sku} placeholder="e.g. KB-002" onChange={(e) => setForm({ ...form, sku: e.target.value })} /></label>
              <label>Product name<input required maxLength={160} value={form.name} placeholder="e.g. Ergonomic Keyboard" onChange={(e) => setForm({ ...form, name: e.target.value })} /></label>
              <label>Category<select required value={form.categoryId} onChange={(e) => setForm({ ...form, categoryId: e.target.value })}><option value="">Choose a category</option>{categories.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}</select></label>
              <label>Unit price (USD)<input required type="number" min="0" step="0.01" value={form.price} placeholder="0.00" onChange={(e) => setForm({ ...form, price: e.target.value })} /></label>
              <p className="form-hint">New products are created with zero stock. Inventory quantities will be managed separately.</p>
              <div className="modal-actions"><button type="button" className="secondary" onClick={() => setShowForm(false)}>Cancel</button><button type="submit" className="primary" disabled={busy}>{busy ? 'Saving…' : editingId === null ? 'Create product' : 'Save changes'}</button></div>
            </form>
          </section>
        </div>
      )}
      <footer>Smart Inventory · Local development environment</footer>
    </main>
  );
}

createRoot(document.getElementById('root')!).render(<App />);
