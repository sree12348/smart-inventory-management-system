*{box-sizing:border-box}body{margin:0;background:#f4f7fb;color:#16243b;font:15px system-ui,-apple-system,sans-serif}main{max-width:1120px;margin:auto;padding:48px 22px}header{margin-bottom:32px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:2px;color:#5676ac}h1{font-size:38px;margin:8px 0}h2{margin:0 0 12px}p{color:#60718b}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px}article,.panel{background:white;border:1px solid #e0e7f0;border-radius:16px;padding:22px;box-shadow:0 3px 14px #15223c08}article small{display:block;color:#63738b;margin-bottom:14px}article strong{font-size:28px}.panel{margin:22px 0}.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left}th,td{padding:14px 12px;border-bottom:1px solid #e8edf3}th{color:#64748b;font-size:12px;text-transform:uppercase}button{background:#265bc2;color:white;border:0;border-radius:8px;padding:9px 15px;cursor:pointer}button:disabled{opacity:.4}.status{background:#eaf1ff;color:#2453a6;padding:5px 10px;border-radius:20px}.error{color:#a32626}.success{color:#197447}@media(max-width:700px){.stats{grid-template-columns:repeat(2,1fr)}h1{font-size:30px}}