import React,{useEffect,useState} from 'react';import{createRoot}from'react-dom/client';import './style.css';
const API='/api';type Product={id:number;sku:string;name:string;price:number;category:string;stock:number};type Order={id:number;customer:string;status:string;total:number};
function App(){const[products,setProducts]=useState<Product[]>([]),[orders,setOrders]=useState<Order[]>([]),[stats,setStats]=useState<Record<string,number>>({}),[error,setError]=useState(''),[message,setMessage]=useState(''),[busy,setBusy]=useState(false);const load=async()=>{try{const res=await Promise.all(['products','orders','dashboard'].map(x=>fetch(`${API}/${x}`).then(r=>{if(!r.ok)throw Error('API unavailable');return r.json()})));setProducts(res[0]);setOrders(res[1]);setStats(res[2]);setError('')}catch(e){setError(String(e))}};useEffect(()=>{void load()},[]);const order=async(p:Product)=>{setBusy(true);setMessage('');try{const r=await fetch(`${API}/orders`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({customerId:1,productId:p.id,warehouseId:1,quantity:1})});if(!r.ok){const detail=await r.text();throw Error(detail)}setMessage(`Order created for ${p.name}`);await load()}catch(e){setError(String(e))}finally{setBusy(false)}};return <main><header><span className="eyebrow">OPERATIONS / OVERVIEW</span><h1>Smart Inventory</h1><p>Products, warehouse stock and order fulfillment in one place.</p></header><section className="stats">{[['Products',stats.products],['Orders',stats.orders],['Units in stock',stats.unitsInStock],['Revenue','$'+Number(stats.revenue||0).toFixed(2)]].map(([k,v])=><article key={k}><small>{k}</small><strong>{v??'—'}</strong></article>)}</section>{error&&<p className="error">{error}</p>}{message&&<p className="success">{message}</p>}<section className="panel"><h2>Product inventory</h2><p>Click Order 1 to create a transactional order using the demo customer and main warehouse.</p><div className="scroll"><table><thead><tr><th>SKU</th><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Action</th></tr></thead><tbody>{products.map(p=><tr key={p.id}><td>{p.sku}</td><td>{p.name}</td><td>{p.category}</td><td>${Number(p.price).toFixed(2)}</td><td>{p.stock}</td><td><button disabled={busy||p.stock<1} onClick={()=>void order(p)}>Order 1</button></td></tr>)}</tbody></table></div></section><section className="panel"><h2>Recent orders</h2><div className="scroll"><table><thead><tr><th>ID</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead><tbody>{orders.map(o=><tr key={o.id}><td>#{o.id}</td><td>{o.customer}</td><td><span className="status">{o.status}</span></td><td>${Number(o.total).toFixed(2)}</td></tr>)}</tbody></table></div></section></main>};createRoot(document.getElementById('root')!).render(<App/>);
